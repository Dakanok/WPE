---
layout: base.njk
title: Woovebox Patches Exchange
---

<h1 class="mb-4">Woovebox Patches Exchange</h1>

<div class="d-flex flex-wrap gap-2 mb-4">
  <button type="button" class="btn btn-outline-primary" data-filter="all">Tous</button>
  {% for tag in tags %}
<button type="button" class="btn btn-outline-primary" data-filter=".tag-{{ tag }}">{{ tag | capitalize }}</button>
  {% endfor %}
</div>

<div id="patches" class="row g-4">
  {% for patch in patches %}
<div class="col-12 col-md-6 col-lg-4 mix tag-{{ patch.tag }}">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h5 card-title">{{ patch.name }}</h2>
        <span class="badge text-bg-secondary"><i class="fa-solid fa-tag"></i> {{ patch.tag }}</span>
        <audio class="w-100 mt-3" controls preload="none"
               src="/assets/samples/{{ patch.file }}.mp3"></audio>
      </div>
      <div class="card-footer bg-transparent">
        <a class="btn btn-primary w-100" download
           href="/assets/patches/{{ patch.file }}.syx">
          <i class="fa-solid fa-download"></i> Télécharger
        </a>
      </div>
    </div>
  </div>
  {% endfor %}
</div>
<div class="d-flex flex-column align-items-center gap-2 mt-4">
  <div class="mixitup-page-list d-flex flex-wrap justify-content-center gap-2"></div>
  <div class="mixitup-page-stats text-body-secondary small"></div>
</div>