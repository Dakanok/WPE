<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <script>
      // Thème choisi par l'utilisateur, sinon préférence du navigateur
      (function () {
        var theme;
        try {
          theme = localStorage.getItem("theme");
        } catch (e) {}
        if (! theme) {
          theme = matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }
        document.documentElement.setAttribute("data-bs-theme", theme);
      })();
    </script>
    <link rel="stylesheet" href="/assets/vendor/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/styles/main.css">
  </head>
  <body>
    <nav class="navbar bg-body-tertiary border-bottom">
      <div class="container">
        <a class="navbar-brand fw-semibold" href="/">Woovebox Patches Exchange</a>
        <div class="d-flex gap-2">
          <button
            type="button"
            class="btn btn-primary"
            data-bs-toggle="offcanvas"
            data-bs-target="#submit-offcanvas"
            aria-controls="submit-offcanvas">
            <i class="fa-solid fa-upload"></i>
            <span class="d-none d-sm-inline">Submit a patch</span>
          </button>
          <button id="theme-toggle" type="button" class="btn btn-outline-secondary" aria-label="Toggle dark mode">
            <i class="fa-solid fa-moon icon-moon"></i>
            <i class="fa-solid fa-lightbulb icon-sun"></i>
          </button>
        </div>
      </div>
    </nav>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="submit-offcanvas" aria-labelledby="submit-offcanvas-label">
      <div class="offcanvas-header">
        <h2 class="offcanvas-title h5" id="submit-offcanvas-label">Submit a patch</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <p>Send an email with:</p>
        <ul>
          <li>The patch file (<code>.syx</code>)
            <span class="text-body-secondary">(required)</span>
          </li>
          <li>Patch name
            <span class="text-body-secondary">(required)</span>
          </li>
          <li>Patch instrument, e.g. bass, lead
            <span class="text-body-secondary">(required)</span>
          </li>
          <li>Example mp3
            <span class="text-body-secondary">(required)</span>
          </li>
          <li>Style
            <span class="text-body-secondary">(optional)</span>
          </li>
          <li>Author
            <span class="text-body-secondary">(optional)</span>
          </li>
        </ul>
        <div class="bg-body-tertiary border rounded p-3">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="submit-consent">
            <label class="form-check-label" for="submit-consent">
              I agree that the patch I send may be published on this site and offered to the community for all types of projects,
              including commercial ones.
            </label>
          </div>
        </div>
        <div id="submit-email" class="mt-3" hidden>
          <p class="mb-1">Send your email to (click to copy):</p>
          <button type="button" id="copy-email" class="btn btn-link p-0 fw-semibold text-start" title="Copy to clipboard">
            woovepatch@proton.me
            <i class="fa-regular fa-copy ms-1"></i>
          </button>
          <div id="copy-feedback" aria-live="polite"></div>
        </div>
      </div>
    </div>
    <main class="container py-4">
      {{ content | safe }}
    </main>
    <script src="/assets/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/mixitup/mixitup.min.js"></script>
    <script src="/assets/vendor/mixitup/mixitup-pagination.min.js"></script>
    <script src="/assets/vendor/mixitup/mixitup-multifilter.min.js"></script>
    <script src="/assets/js/main.js"></script>
  </body>
</html>